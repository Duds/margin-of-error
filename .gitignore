# Python bytecode. The chart generators are stdlib-only and are run directly
# (python3 charts/chart-01.py) and by tools/build.py, so these get written on
# every run and are never wanted in the repo.
__pycache__/
*.py[cod]

# Generated chart SVG is committed on purpose: index.html is generated output
# and is committed, so the artefacts it is built from are committed too. This
# note is here so nobody adds charts/*.svg to this file by mistake.

# Editor and OS noise.
.DS_Store
*.swp

# Plan execution scratch: ledger, briefs, review packages. Git-ignored by
# design; `git clean -fdx` destroys it, and progress is recovered from git log.
.superpowers/

# Browser verification artefacts. Screenshots and console logs written by the
# Playwright MCP server during chart layout checks; the measurements that
# matter are asserted in tests/test_scales.py, not kept as images.
.playwright-mcp/
